{
  "id": "outlook_desktop",
  "name": "Outlook Desktop",
  "version": "2024",
  "supports": {
    "css_flexbox": false,
    "css_grid": false,
    "css_variables": false,
    "css_animations": false,
    "border_radius": false,
    "background_image": false,
    "media_queries": false,
    "dark_mode_media_query": false,
    "position_absolute": false,
    "margin_auto": false,
    "padding_shorthand": true,
    "max_width": true,
    "min_width": false
  },
  "quirks": {
    "table_layout_required": true,
    "inline_styles_only": true,
    "strips_style_tags": false,
    "vml_support": true,
    "gmail_class_prefix": false
  },
  "button_strategy": "vml-table",
  "layout_strategy": "table",
  "image_strategy": "standard"
}
